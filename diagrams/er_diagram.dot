digraph ER {
  graph [rankdir=LR, splines=true, overlap=false, nodesep=0.30, ranksep=0.85,
         fontname="Helvetica", bgcolor="white", pad=0.3, label="YouTube Video Sharing Database — Phase 2 ER diagram\nPK = primary key, FK = foreign key, UQ = unique; edge labels show cardinality", labelloc="t", fontsize=14];
  node [shape=plaintext, fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=8, color="#6b7280", fontcolor="#374151", dir=both, arrowtail=odot, arrowhead=crow, penwidth=1.0];
  users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#dbeafe" align="center"><font point-size="13"><b>users</b></font></td></tr><tr><td align="left" port="user_id"><font color="#111827">user_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#b91c1c"><b>PK</b></font></td></tr><tr><td align="left" port="email"><font color="#111827">email</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"><b>UQ</b></font></td></tr><tr><td align="left" port="display_name"><font color="#111827">display_name</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="country_code"><font color="#111827">country_code</font></td><td align="left"><font color="#4b5563">char(2)</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="birth_year"><font color="#111827">birth_year</font></td><td align="left"><font color="#4b5563">smallint</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="premium_until"><font color="#111827">premium_until</font></td><td align="left"><font color="#4b5563">date</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="created_at"><font color="#111827">created_at</font></td><td align="left"><font color="#4b5563">timestamptz</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  channels [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#e0e7ff" align="center"><font point-size="13"><b>channels</b></font></td></tr><tr><td align="left" port="channel_id"><font color="#111827">channel_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#b91c1c"><b>PK</b></font></td></tr><tr><td align="left" port="owner_user_id"><font color="#111827">owner_user_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK UQ</b></font></td></tr><tr><td align="left" port="handle"><font color="#111827">handle</font></td><td align="left"><font color="#4b5563">varchar(31)</font></td><td align="left"><font color="#374151"><b>UQ</b></font></td></tr><tr><td align="left" port="channel_name"><font color="#111827">channel_name</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="country_code"><font color="#111827">country_code</font></td><td align="left"><font color="#4b5563">char(2)</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="is_verified"><font color="#111827">is_verified</font></td><td align="left"><font color="#4b5563">boolean</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="monetization_status"><font color="#111827">monetization_status</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="subscriber_count"><font color="#111827">subscriber_count</font></td><td align="left"><font color="#4b5563">bigint</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="created_at"><font color="#111827">created_at</font></td><td align="left"><font color="#4b5563">timestamptz</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  videos [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#dcfce7" align="center"><font point-size="13"><b>videos</b></font></td></tr><tr><td align="left" port="video_id"><font color="#111827">video_id</font></td><td align="left"><font color="#4b5563">varchar(11)</font></td><td align="left"><font color="#b91c1c"><b>PK</b></font></td></tr><tr><td align="left" port="channel_id"><font color="#111827">channel_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left" port="title"><font color="#111827">title</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="description"><font color="#111827">description</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="category"><font color="#111827">category</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="duration_sec"><font color="#111827">duration_sec</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="is_short"><font color="#111827">is_short</font></td><td align="left"><font color="#4b5563">boolean</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="is_made_for_kids"><font color="#111827">is_made_for_kids</font></td><td align="left"><font color="#4b5563">boolean</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="visibility"><font color="#111827">visibility</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="uploaded_at"><font color="#111827">uploaded_at</font></td><td align="left"><font color="#4b5563">timestamptz</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="published_at"><font color="#111827">published_at</font></td><td align="left"><font color="#4b5563">timestamptz</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="view_count"><font color="#111827">view_count</font></td><td align="left"><font color="#4b5563">bigint</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  subscriptions [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#fef3c7" align="center"><font point-size="13"><b>subscriptions</b></font></td></tr><tr><td align="left" port="user_id"><font color="#111827">user_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#b91c1c"><b>PK FK</b></font></td></tr><tr><td align="left" port="channel_id"><font color="#111827">channel_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#b91c1c"><b>PK FK</b></font></td></tr><tr><td align="left" port="notifications"><font color="#111827">notifications</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="subscribed_at"><font color="#111827">subscribed_at</font></td><td align="left"><font color="#4b5563">timestamptz</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  watch_events [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#fde68a" align="center"><font point-size="13"><b>watch_events</b></font></td></tr><tr><td align="left" port="watch_id"><font color="#111827">watch_id</font></td><td align="left"><font color="#4b5563">bigint</font></td><td align="left"><font color="#b91c1c"><b>PK</b></font></td></tr><tr><td align="left" port="user_id"><font color="#111827">user_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left" port="video_id"><font color="#111827">video_id</font></td><td align="left"><font color="#4b5563">varchar(11)</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left" port="started_at"><font color="#111827">started_at</font></td><td align="left"><font color="#4b5563">timestamptz</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="watch_seconds"><font color="#111827">watch_seconds</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="device"><font color="#111827">device</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="traffic_source"><font color="#111827">traffic_source</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  video_reactions [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#fce7f3" align="center"><font point-size="13"><b>video_reactions</b></font></td></tr><tr><td align="left" port="user_id"><font color="#111827">user_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#b91c1c"><b>PK FK</b></font></td></tr><tr><td align="left" port="video_id"><font color="#111827">video_id</font></td><td align="left"><font color="#4b5563">varchar(11)</font></td><td align="left"><font color="#b91c1c"><b>PK FK</b></font></td></tr><tr><td align="left" port="reaction"><font color="#111827">reaction</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="reacted_at"><font color="#111827">reacted_at</font></td><td align="left"><font color="#4b5563">timestamptz</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  comments [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#fae8ff" align="center"><font point-size="13"><b>comments</b></font></td></tr><tr><td align="left" port="comment_id"><font color="#111827">comment_id</font></td><td align="left"><font color="#4b5563">bigint</font></td><td align="left"><font color="#b91c1c"><b>PK</b></font></td></tr><tr><td align="left" port="video_id"><font color="#111827">video_id</font></td><td align="left"><font color="#4b5563">varchar(11)</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left" port="user_id"><font color="#111827">user_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left" port="parent_comment_id"><font color="#111827">parent_comment_id</font></td><td align="left"><font color="#4b5563">bigint</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left" port="body"><font color="#111827">body</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="like_count"><font color="#111827">like_count</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="is_pinned"><font color="#111827">is_pinned</font></td><td align="left"><font color="#4b5563">boolean</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="created_at"><font color="#111827">created_at</font></td><td align="left"><font color="#4b5563">timestamptz</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  playlists [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#ede9fe" align="center"><font point-size="13"><b>playlists</b></font></td></tr><tr><td align="left" port="playlist_id"><font color="#111827">playlist_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#b91c1c"><b>PK</b></font></td></tr><tr><td align="left" port="owner_user_id"><font color="#111827">owner_user_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left" port="title"><font color="#111827">title</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="visibility"><font color="#111827">visibility</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="created_at"><font color="#111827">created_at</font></td><td align="left"><font color="#4b5563">timestamptz</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  playlist_items [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#ddd6fe" align="center"><font point-size="13"><b>playlist_items</b></font></td></tr><tr><td align="left" port="playlist_id"><font color="#111827">playlist_id</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#b91c1c"><b>PK FK</b></font></td></tr><tr><td align="left" port="video_id"><font color="#111827">video_id</font></td><td align="left"><font color="#4b5563">varchar(11)</font></td><td align="left"><font color="#b91c1c"><b>PK FK</b></font></td></tr><tr><td align="left" port="position"><font color="#111827">position</font></td><td align="left"><font color="#4b5563">integer</font></td><td align="left"><font color="#374151"><b>UQ</b></font></td></tr><tr><td align="left" port="added_at"><font color="#111827">added_at</font></td><td align="left"><font color="#4b5563">timestamptz</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  ad_impressions [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td colspan="3" bgcolor="#ffedd5" align="center"><font point-size="13"><b>ad_impressions</b></font></td></tr><tr><td align="left" port="impression_id"><font color="#111827">impression_id</font></td><td align="left"><font color="#4b5563">bigint</font></td><td align="left"><font color="#b91c1c"><b>PK</b></font></td></tr><tr><td align="left" port="watch_id"><font color="#111827">watch_id</font></td><td align="left"><font color="#4b5563">bigint</font></td><td align="left"><font color="#1d4ed8"><b>FK</b></font></td></tr><tr><td align="left" port="ad_format"><font color="#111827">ad_format</font></td><td align="left"><font color="#4b5563">text</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="revenue_inr"><font color="#111827">revenue_inr</font></td><td align="left"><font color="#4b5563">numeric(10,4)</font></td><td align="left"><font color="#374151"> </font></td></tr><tr><td align="left" port="shown_at"><font color="#111827">shown_at</font></td><td align="left"><font color="#4b5563">timestamptz</font></td><td align="left"><font color="#374151"> </font></td></tr></table>>];
  users -> channels [label="1 : 0..1  owns"];
  channels -> videos [label="1 : N  publishes"];
  users -> subscriptions [label="1 : N  subscribes"];
  channels -> subscriptions [label="1 : N  has"];
  users -> watch_events [label="0..1 : N  generates"];
  videos -> watch_events [label="1 : N  receives"];
  users -> video_reactions [label="1 : N  reacts"];
  videos -> video_reactions [label="1 : N  receives"];
  users -> comments [label="1 : N  writes"];
  videos -> comments [label="1 : N  has"];
  comments -> comments [label="0..1 : N  replies to"];
  users -> playlists [label="1 : N  owns"];
  playlists -> playlist_items [label="1 : N  contains"];
  videos -> playlist_items [label="1 : N  included in"];
  watch_events -> ad_impressions [label="1 : N  shows"];
}
